<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- Keep multiple NUnit test hosts from racing to aggregate coverage. -->
    <MaxCpuCount>1</MaxCpuCount>
  </RunConfiguration>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <IncludeTestAssembly>False</IncludeTestAssembly>
          <!-- CLI process-contract tests run separately from NUnit coverage counters. -->
          <CollectFromChildProcesses>False</CollectFromChildProcesses>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*(Infoconex\.DotNetBinary\.(Domain|Application|Infrastructure)|dotnet-binary)\.dll$</ModulePath>
              </Include>
            </ModulePaths>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
